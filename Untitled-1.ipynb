import pandas as pd
import os

# Pfad zu den Daten
base_path = r'c:\Users\samso\Documents\00 Uni\Semester 9\sonar_mpa\data\messung_15_12_25'

# Dateinamen der drei "Trainsitaten" (Trainingsdaten)
files = [
    'grabel_training_data.csv',
    'sand_training_data.csv', 
    'stone_training_data.csv'
]

data_frames = []

for file in files:
    file_path = os.path.join(base_path, file)
    # Einlesen der CSV-Dateien, Trennzeichen ist Semikolon
    df = pd.read_csv(file_path, sep=';')
    data_frames.append(df)

# Zusammenfügen zu einem einzigen DataFrame
full_df = pd.concat(data_frames, ignore_index=True)

# Filtern der Spalten: Wir wollen 'class_name' und alle 'S_...' Spalten
# Identifizieren der Spalten, die mit 'S_' beginnen
amplitude_cols = [col for col in full_df.columns if col.startswith('S_')]

# Auswahl der gewünschten Spalten
selected_cols = ['class_name'] + amplitude_cols
final_df = full_df[selected_cols]

# Optional: Umbenennen von 'class_name' in 'Klasse', falls gewünscht
final_df = final_df.rename(columns={'class_name': 'Klasse'})

# Anzeigen der ersten Zeilen und der Größe des DataFrames
print(f"Form des DataFrames: {final_df.shape}")
display(final_df.head())
